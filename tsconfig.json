{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // P0-12 (Engineering Audit): noImplicitAny is intentionally kept false
    // for now. Flipping to true generates 409 implicit-any errors across
    // the codebase (mostly in modules/* view components and lib/accounting
    // helpers). Per the P0 remediation sprint constraint to "keep changes
    // minimal" and not open huge modifications, this flip is deferred to a
    // follow-up sprint where the 409 sites can be annotated individually.
    // The audit's other Critical fixes (SSRF, JWT, auth, schema drift,
    // rate-limit, code-split, Account.id validators) ARE applied.
    "noImplicitAny": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/__tests__/**",
    "e2e/**",
    "examples/**",
    "node_modules",
    "scripts/**",
    "seed/**"
  ]
}
