  // ── P2-Reconciliation: columns that exist in DB but were missing from schema ──
  quotationNumber    String
  date               String
  validUntil         String?
  lineItems          String
  subtotal           Decimal @default(0) // DB-07 FIX: String→Decimal
  taxRate            Decimal @default(0) // DB-07 FIX: String→Decimal
  taxAmount          Decimal @default(0) // DB-07 FIX: String→Decimal
  notes              String?
  convertedInvoiceId Int?
  createdBy          String?

  // DB-13 FIX (Audit v2 · Phase 3): Optimistic locking for concurrent quote
  // edits (send, accept, reject, convert-to-invoice). Bumped on every write
  // and validated via WHERE version = <expected> to prevent lost updates.
  version Int @default(0)

  @@index([companySlug])
  @@index([companyId])
