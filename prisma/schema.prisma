  @@unique([userId])
}

// ─── Session Registry (matches db.sessionRegistry) ───
//
// P1-2 FIX (audit): schema was out of sync with code. The migration
// 20260730000000_fix_schema_drift.sql added columns `userUid`, `jti`,
// `userAgent` to the table at the DB level, but schema.prisma kept the
// legacy `userId`, `tokenHash`, `deviceInfo` fields. Prisma client was
// generated from the stale schema, so `db.sessionRegistry.create({ userUid,
// jti, userAgent })` would throw "Unknown field" at runtime — except the
// throw was masked by `db: any` in src/lib/db.ts (P0-14 deferred issue).
//
// The schema now matches what the code writes. We also add the missing
// @@unique([jti]) and @@index([userUid]) — both were added at the DB
// level by the migration but not declared in the schema, so Prisma
// client didn't know about them. With these declared, future
// `prisma generate` runs will produce correct types.
//
// Legacy `userId` / `tokenHash` / `deviceInfo` columns still exist in the
// production DB (they were never dropped) but are unused. A separate
// cleanup migration can drop them later — keeping them for now in case
// any historical data needs to be queried.

model SessionRegistry {
  id         String   @id @default(cuid())
  // P1-2: code writes `userUid` (not `userId`). Migration already added
  // this column at the DB level. Schema now matches.
  userUid    String
  // P1-2: code writes `jti` (JWT Token ID) — unique per session. Used
  // by isSessionValid(jti) for revocation lookups.
  jti        String   @unique
  // P1-2: code writes `userAgent` (not `deviceInfo`). Migration added it.
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       AppUser  @relation(fields: [userUid], references: [uid], onDelete: Cascade)

  // P1-2: index on userUid — enforceSessionLimit() queries
  // `findMany({ where: { userUid } })` on every login. Without this index
  // that query is a full scan.
  @@index([userUid])
