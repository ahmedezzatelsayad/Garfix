  description        String?
  journalEntryIdFrom String? // P2-Sprint-4: changed from Int? to String? — references JournalEntry.id (cuid)
  journalEntryIdTo   String? // P2-Sprint-4: changed from Int? to String? — references JournalEntry.id (cuid)
  settledAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([companySlugFrom])
  @@index([companySlugTo])
  @@index([companySlugFrom, companySlugTo, status])
  @@map("inter_company_transactions")
}

