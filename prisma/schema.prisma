  entity      String // journal_entry, fiscal_period, account
  entityId    String?
  performedBy String?
  details     String?
  createdAt   DateTime @default(now())

  @@index([companySlug])
  // P1-3: same as AuditLog — append-only, filtered by date + entity
  @@index([createdAt])
  @@index([entity, entityId])
  @@map("accounting_audit_logs")
}

// ─── Admin Audit Log (matches db.adminAuditLog) ───

model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  adminEmail String
  action     String
  targetSlug String?
  details    String?
  createdAt  DateTime @default(now())

  // P1-3: AdminAuditLog had NO indexes at all. Platform admin panel filters
  // by adminEmail + paginates by createdAt.
  @@index([adminEmail])
  @@index([createdAt])
  @@index([targetSlug])
  @@map("admin_audit_logs")
}

