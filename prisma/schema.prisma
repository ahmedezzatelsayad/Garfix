model RefundTransaction {
  id                    String    @id @default(cuid())
  originalTransactionId String?
  paymentTransactionId  String? // P2-Sprint-4: link to PaymentTransaction
  amount                Decimal   @default(0)
  reason                String?
  status                String    @default("pending") // pending, approved, processed, failed
  providerRefundId      String? // P2-Sprint-4: provider-side refund ID
  processedAt           DateTime?
  companySlug           String    @default("default")
  companyId             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([companySlug])
  @@index([companyId])
  @@index([paymentTransactionId])
  @@map("refund_transactions")
}

// ─── Post-Dated Check (matches db.postDatedCheck) ───

model PostDatedCheck {
