// ═══════════════════════════════════════════════════════════════════════════════
// GarfiX ERP — Prisma Schema v2 (P0-1: Full Runtime Model Sync)
// ═══════════════════════════════════════════════════════════════════════════════
//
// NOTE: Financial fields use Decimal instead of Float for production accuracy.
// SQLite doesn't support Decimal, so in dev it falls back to Float-like behavior.
// For PostgreSQL production, Decimal ensures exact precision (no floating-point errors).
//
// DB-07 FIX (Audit v2 · Phase 2): All monetary fields declared as String are now
// Decimal @default(0) (or Decimal? if nullable). Companion migration
// 20260813150000_p2_string_to_decimal_monetary_fields aligns the DB column types.
// See migration SQL for the full list of ALTER COLUMN statements.
//
// This schema aligns model names with db.xxx calls in the runtime code.
// All models referenced in src/ are now defined here.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Core Business Models
// ═══════════════════════════════════════════════════════════════════════════════

// ─── AppUser (replaces User — matches db.appUser) ───

// AppUser — the canonical user model used across all auth + RBAC code.
// Fields `passwordHash`, `displayName`, `companies`, `permissions` are
// intentionally NOT camelCased — the auth API routes (register/login/me/
// refresh/change-password/forgot/reset) and src/lib/auth.ts read/write
// them by these exact names. JSON-encoded fields (`companies`, `permissions`)
// store arrays/objects as TEXT to avoid join tables for the simple RBAC
// model. `role` defaults to "employee" (NOT "user") so new signups match
// ROLE_DEFAULTS in AuthContext.
model AppUser {
  uid                String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  displayName        String   @default("")
  role               String   @default("employee")
  companies          String   @default("[]") // JSON array of company slugs
  permissions        String   @default("{}") // JSON object of permission → 0/1
  emailVerified      Boolean  @default(false)
  tokenVersion       Int      @default(0)
  // ── Branch/Warehouse support: user's default branch ──
  defaultWarehouseId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  mFASecrets       MFASecret[]
  sessions         SessionRegistry[]
  defaultWarehouse Warehouse?        @relation("UserDefaultWarehouse", fields: [defaultWarehouseId], references: [id])

  // API Key Pool - User can have one assigned key
  assignedApiKey ApiKeyPool? @relation("KeyAssignedToUser")

  // Phase 4 P3: CompanyMembership relation (replaces JSON companies column)
  memberships CompanyMembership[]

  @@map("app_users")
}

// ─── Company (matches db.company) ───

model Company {
  id                      String    @id @default(cuid())
  name                    String
  code                    String    @unique @default(cuid())
  slug                    String    @unique @default("default-slug")
  plan                    String    @default("trial")
  subscriptionStatus      String    @default("inactive")
  currency                String    @default("USD")
  taxId                   String?
  address                 String?
  // Brand + locale + trial fields used by onboarding wizard and settings page.
  nameAr                  String?
  emoji                   String?
  color                   String?
  phone                   String?
  vatNumber               String?
  country                 String?
  defaultTaxRate          Decimal   @default(0) // DB-07 FIX: String→Decimal
  trialEndsAt             DateTime?
  commercialRegistration  String?
  timezone                String?
  weekendDays             String?
  ramadanHours            String?
  openrouterModel         String?
  // WhatsApp integration fields
  whatsappVerifyTokenHash String?
  whatsappAppSecretEnc    String?
  whatsappPhoneNumberId   String?
  whatsappEnabled         Boolean   @default(false)
  // P2-Sprint-4: subscription billing cycle end (used by subscription-engine)
  currentBillingCycleEnd  DateTime?
  deletedAt               DateTime? // P0-3: Soft Delete
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  accounts            Account[]
  clients             Client[]
  suppliers           Supplier[]
  journalEntries      JournalEntry[]
  paymentVouchers     PaymentVoucher[]
  fiscalPeriods       FiscalPeriod[]
  openingBalances     OpeningBalanceEntry[]
  profitDistributions ProfitDistribution[]
  lettersOfCredit     LetterOfCredit[]
  productCatalogs     ProductCatalog[]
  inventoryItems      InventoryItem[]
  warehouses          Warehouse[]
  fixedAssets         FixedAsset[]
  bankAccounts        BankAccount[]
  budgets             Budget[]
  costCenters         CostCenter[]
  employees           Employee[]
  purchaseInvoices    PurchaseInvoice[]
  invoices            Invoice[]
  quotations          Quotation[]
  purchaseOrders      PurchaseOrder[]

  aiConfig CompanyAIConfig?

  // API Key Pool - Keys assigned to this company's users
  assignedApiKeys ApiKeyPool[] @relation("KeyAssignedToCompany")

  // Recurring & Fiscal Year features
  recurringEntries RecurringJournalEntry[]
  fiscalYearCloses FiscalYearClose[]

  // ── P2-Reconciliation: columns that exist in DB but were missing from schema ──
  nameEn                String?
  currencyDecimalPlaces Int

  // Phase 4 P3: CompanyMembership relation (replaces JSON companies column)
  memberships CompanyMembership[]

  // P1-3: Company has soft-delete (deletedAt) but no index. /api/companies
  // list queries filter `where: { deletedAt: null }`.
  @@index([deletedAt])
  @@map("companies")
}

// ─── Account (Chart of Accounts — matches db.account) ───

model Account {
  id                String                @id @default(cuid())
  code              String
  name              String
  type              String // asset, liability, equity, revenue, expense
  parentId          String?
  companyId         String
  companySlug       String                @default("default")
  balance           Decimal               @default(0) // Running balance — updated on JE posting
  isActive          Boolean               @default(true)
  version           Int                   @default(0) // P0-8: Optimistic Locking for balance updates
  // Bilingual name + currency fields written by onboarding wizard (were missing).
  nameAr            String?
  nameEn            String?
  currency          String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  company           Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent            Account?              @relation("AccountHierarchy", fields: [parentId], references: [id])
  children          Account[]             @relation("AccountHierarchy")
  openingBalances   OpeningBalanceEntry[]
  journalEntryLines JournalEntryLine[]
  // P0-06: back-relation for PaymentVoucher.glAccountId
  paymentVouchersGL PaymentVoucher[]      @relation("PaymentVoucherGLAccount")
  // P2-Sprint6: back-relations for BankAccount/FixedAsset/Budget
  bankAccountsGL    BankAccount[]         @relation("BankAccountGLAccount")
  fixedAssetsGL     FixedAsset[]          @relation("FixedAssetGLAccount")
  fixedAssetsDep    FixedAsset[]          @relation("FixedAssetDepreciationAccount")
  fixedAssetsExp    FixedAsset[]          @relation("FixedAssetExpenseAccount")
  budgets           Budget[]              @relation("BudgetAccount")

  @@unique([code, companyId])
  @@index([companySlug])
  @@index([companyId])
  @@map("accounts")
}

// ─── Client (Accounts Receivable — matches db.client) ───

model Client {
  id              String           @id @default(cuid())
  name            String
  code            String           @default(cuid())
  email           String?
  phone           String?
  address         String?
  taxId           String?
  companySlug     String           @default("default")
  companyId       String?
  isActive        Boolean          @default(true)
  deletedAt       DateTime? // P0-3: Soft Delete
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  paymentVouchers PaymentVoucher[]
  invoices        Invoice[]
  quotations      Quotation[]
  version         Int              @default(0) // Phase 15 P0: Optimistic Locking

  // ── P2-Reconciliation: columns that exist in DB but were missing from schema ──
  nameEn        String?
  // ── P2-Sprint6: add clientCompany, notes ──
  clientCompany String?
  notes         String?

  @@index([companySlug])
  @@index([companyId])
  // P1-3: soft-delete index — clients/route.ts filters `where: { deletedAt: null }`
  @@index([companySlug, deletedAt])
  @@map("clients")
}

// ─── Supplier (Accounts Payable — matches db.supplier) ───

model Supplier {
  id               String            @id @default(cuid())
  name             String
  code             String
  email            String?
  phone            String?
  address          String?
  taxId            String?
  companyId        String
  companySlug      String            @default("default")
  isActive         Boolean           @default(true)
  // P0-08: Soft-delete column — the /api/suppliers GET route filters on
  // `WHERE deletedAt IS NULL`. The column was missing → every list call
  // returned empty / errored.
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  paymentVouchers  PaymentVoucher[]
  lettersOfCredit  LetterOfCredit[]
  purchaseInvoices PurchaseInvoice[]
  version          Int               @default(0) // Phase 15 P0: Optimistic Locking

  // ── P2-Reconciliation: columns that exist in DB but were missing from schema ──
  nameEn String?

  @@unique([code, companyId])
  @@index([companySlug])
  @@index([companyId])
  // P1-3: composite soft-delete index — supplier-statement/route.ts filters
  // `where: { companySlug, deletedAt: null }`. Composite is more selective
  // than the standalone @@index([deletedAt]) that was here before.
  @@index([companySlug, deletedAt])
  @@map("suppliers")
}

// ─── Product Catalog (matches db.productCatalog) ───

model ProductCatalog {
  id                 String              @id @default(cuid())
  name               String
  sku                String              @default("")
  code               String?
  category           String?
  purchasePrice      Decimal             @default(0)
  sellingPrice       Decimal             @default(0)
  unit               String              @default("piece")
  description        String?
  companySlug        String              @default("default")
  companyId          String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  company            Company?            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  inventoryItems     InventoryItem[]
  productAliases     ProductAlias[]
  productMatchAudits ProductMatchAudit[]
  matchOverrides     MatchOverride[]
  landedCostLines    LandedCostLine[]

  // ── P2-Reconciliation: columns that exist in DB but were missing from schema ──
  nameAr         String?
  nameEn         String?
  // ── P2-Sprint6: add wholesalePrice ──
  wholesalePrice Decimal @default(0)

  @@index([companySlug])
  @@index([companyId])
  @@map("product_catalog")
}

// ─── Inventory Item (matches db.inventoryItem) ───

model InventoryItem {
  id           String         @id @default(cuid())
  productId    String
  quantity     Decimal        @default(0)
  reorderLevel Decimal        @default(0)
  warehouseId  String?
  warehouse    String?
  batchNumber  String?
  expiryDate   DateTime?
  companySlug  String         @default("default")
  companyId    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  product      ProductCatalog @relation(fields: [productId], references: [id])
  company      Company?       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouseRef Warehouse?     @relation(fields: [warehouseId], references: [id])

  // ── P2-Sprint6: add reorderQty alias for backward compat ──
  reorderQty Decimal @default(0)

  @@index([companySlug])
  @@index([companyId])
  @@map("inventory_items")
}

// ─── Warehouse (matches db.warehouse) ───

model Warehouse {
  id             String          @id @default(cuid())
  name           String
  code           String
  companySlug    String
  companyId      String?
  /// Optional active flag used by inventory sync queries.
  isActive       Boolean         @default(true)
  /// Optional address used by warehouse detail pages.
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  /// ── Branch/Warehouse support: invoices + users linked to this branch ──
  invoices       Invoice[]
  defaultUsers   AppUser[]       @relation("UserDefaultWarehouse")
  company        Company?        @relation(fields: [companyId], references: [id], onDelete: Restrict)

  // ── P2-Reconciliation: columns that exist in DB but were missing from schema ──
  nameAr String?

  @@index([companySlug])
  @@index([companyId])
  @@map("warehouses")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Accounting Core Models (P0-2, P0-4, P0-5, P0-8)
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Fiscal Period (matches db.fiscalPeriod — renamed from FinancialPeriod) ───

model FiscalPeriod {
  id              String                @id @default(cuid())
  name            String
  startDate       DateTime
  endDate         DateTime
  status          String                @default("open") // open, closed, locked
  companyId       String
  companySlug     String                @default("default")
  closedBy        String?
  closedAt        DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  company         Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  openingBalances OpeningBalanceEntry[]

  // ── P2-Reconciliation: columns that exist in DB but were missing from schema ──
  fiscalYear Int
  periodType String

  @@unique([name, companyId])
  @@index([companySlug])
  @@index([companyId])
  @@map("fiscal_periods")
}

// ─── Journal Entry (matches db.journalEntry — renamed from Voucher) ───
// P0-2: Posted entries are IMMUTABLE — cannot be deleted/modified
// P0-4: Cannot post to closed/locked periods
// P0-5: Minimum 2 lines, balanced debit/credit, accounts must exist
// P0-8: Version field for optimistic locking

model JournalEntry {
  id                    String                @id @default(cuid())
  number                String
  date                  DateTime
  description           String?
  reference             String?
  status                String                @default("draft") // draft, posted, cancelled
  entryType             String                @default("general") // general, payment, receipt, transfer
  companyId             String
  companySlug           String                @default("default")
  createdBy             String?
  version               Int                   @default(0) // P0-8: Optimistic Locking
  // P2-Sprint-4: sourceType/sourceId exist in DB migration but were missing from schema.
  // Used by inter-company settle route and audit trails to track what created the entry.
  sourceType            String? // e.g. "inter_company", "invoice", "payment", "manual"
  sourceId              String? // P2-Sprint-4: changed from Int? to String? — polymorphic FK to source record (cuid)
  deletedAt             DateTime? // P0-3: Soft Delete
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  company               Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lines                 JournalEntryLine[]
  // P0-05/P0-06: back-relations for OpeningBalanceEntry.journalEntryId and
  // PaymentVoucher.journalEntryId.
  openingBalanceEntries OpeningBalanceEntry[]
  paymentVouchers       PaymentVoucher[]
  // P2-Sprint6: back-relation for FxRevaluation.journalEntryId
  fxRevaluations        FxRevaluation[]       @relation("FxRevaluationJournalEntry")

  @@unique([number, companyId])
  @@index([companySlug])
  @@index([companyId])
  // P1-3: soft-delete index — every list query filters `where: { deletedAt: null }`
  // Without this index the query scans the whole table; the deleted fraction
  // grows over time, slowing list responses linearly.
  @@index([companySlug, deletedAt])
  // P1-3: date index — dashboard/aging queries filter by date range
  @@index([date])
  // P5-M1: composite (companySlug, date) backs the tenant+time-range list
  // ordering used by GET /api/journal-entries and aging reports.
  @@index([companySlug, date])
  @@map("journal_entries")
}

// ─── Journal Entry Line (matches db.journalEntryLine — renamed from VoucherLine) ───

model JournalEntryLine {
  id             String       @id @default(cuid())
  accountId      String
  debit          Decimal      @default(0)
  credit         Decimal      @default(0)
  description    String?
  sortOrder      Int          @default(0)
  journalEntryId String
  companySlug    String       @default("default")
  account        Account      @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  // ── P2-Reconciliation: columns that exist in DB but were missing from schema ──
  // P2-Sprint-4: made entryId/createdAt/updatedAt optional — many call sites
  // create JournalEntryLine without these (they're auto-managed by the DB
  // via defaults or populated later by audit hooks).
  entryId      Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  // ── P2-Sprint6: add costCenterId ──
  costCenterId String?
  costCenter   CostCenter? @relation(fields: [costCenterId], references: [id])

  // P1-3: FK indexes — queries that join JournalEntry -> lines scan this
  // table without these. journal_entry_lines grows with every journal entry.
  @@index([journalEntryId])
  @@index([accountId])
  @@index([companySlug])
  @@map("journal_entry_lines")
}

// ─── Payment Voucher (matches db.paymentVoucher) ───

model PaymentVoucher {
  id                   String                @id @default(cuid())
  number               String
  date                 DateTime
  amount               Decimal
  paymentType          String // receipt, payment
  direction            String // inbound, outbound
  status               String                @default("draft") // draft, posted, cancelled
  description          String?
  reference            String?
  clientId             String?
  supplierId           String?
  companyId            String
  companySlug          String                @default("default")
  // ── P0-06: Fields written by createVoucher() in src/lib/accounting/vouchers.ts
  // The library writes these names (separate from `number` / `paymentType` /
  // `direction`). Without them, every voucher create 500s.
  voucherNumber        String?
  voucherType          String? // receipt, payment
  currency             String                @default("SAR")
  amountArText         String?
  payee                String?
  payer                String?
  bankAccountId        String?
  glAccountId          String?
  journalEntryId       String?
  createdBy            String?
  approvedBy           String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  client               Client?               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  supplier             Supplier?             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  bankAccount          BankAccount?          @relation(fields: [bankAccountId], references: [id])
  glAccount            Account?              @relation("PaymentVoucherGLAccount", fields: [glAccountId], references: [id])
  journalEntry         JournalEntry?         @relation(fields: [journalEntryId], references: [id])
  installmentSchedules InstallmentSchedule[]
  version              Int                   @default(0) // Phase 15 P0: Optimistic Locking

  @@unique([number, companyId])
  @@index([companySlug])
  @@index([companyId])
  @@index([companySlug, voucherNumber])
  @@map("payment_vouchers")
}

// ─── Installment Schedule (matches db.installmentSchedule) ───

model InstallmentSchedule {
  id               String         @id @default(cuid())
  paymentVoucherId String
  amount           Decimal
  dueDate          DateTime
  status           String         @default("pending") // pending, paid, overdue, cancelled
  paidDate         DateTime?
  paymentRef       String?
  companySlug      String         @default("default")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  paymentVoucher   PaymentVoucher @relation(fields: [paymentVoucherId], references: [id], onDelete: Cascade)

  @@index([companySlug])
  @@map("installment_schedules")
}

// ─── Opening Balance Entry (matches db.openingBalanceEntry) ───

model OpeningBalanceEntry {
  id             String        @id @default(cuid())
  accountId      String
  periodId       String
  debit          Decimal       @default(0)
  credit         Decimal       @default(0)
  companyId      String
  companySlug    String        @default("default")
  // ── P0-05: Fields written by /api/accounting/opening-balances
  asOfDate       String? // YYYY-MM-DD, used as JE date when posting
  status         String        @default("draft") // draft, posted
  journalEntryId String? // FK to journal_entries.id, set when posted
  amount         Decimal       @default(0) // single-field amount (code uses this)
  importedFrom   String        @default("manual") // manual, csv, xlsx
  // ── Fields used by API routes for richer opening-balance descriptions
  description    String?
  reference      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  account        Account       @relation(fields: [accountId], references: [id])
  period         FiscalPeriod  @relation(fields: [periodId], references: [id])
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])

  // ── P2-Reconciliation: columns that exist in DB but were missing from schema ──
  notes String?

  @@unique([accountId, periodId])
  @@index([companySlug])
  @@index([companyId])
  @@index([companySlug, status])
  @@map("opening_balance_entries")
}

// ─── Profit Distribution (matches existing) ───

model ProfitDistribution {
  id               String                    @id @default(cuid())
  periodId         String?
  totalProfit      Decimal                   @default(0)
  retained         Decimal                   @default(0)
  distributed      Decimal                   @default(0)
  distributionType String                    @default("proportional")
  status           String                    @default("draft") // draft, approved, executed
  notes            String?
  companyId        String
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  company          Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  entries          ProfitDistributionEntry[]

  // ── P2-Reconciliation: columns that exist in DB but were missing from schema ──
  companySlug String

  @@index([companyId])
  @@index([companySlug])
  @@map("profit_distributions")
}

model ProfitDistributionEntry {
  id             String             @id @default(cuid())
  distributionId String
  shareholder    String
  shareRatio     Decimal            @default(0)
  amount         Decimal            @default(0)
  companySlug    String             @default("default")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  distribution   ProfitDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)

  @@index([companySlug])
  @@map("profit_distribution_entries")
}

// ─── Letter of Credit (matches db.letterOfCredit) ───

model LetterOfCredit {
  id          String                   @id @default(cuid())
  number      String
  type        String                   @default("import")
  amount      Decimal
  currency    String                   @default("USD")
  status      String                   @default("draft")
  issueDate   DateTime?
  expiryDate  DateTime?
  beneficiary String?
  issuingBank String?
  description String?
  reference   String?
  supplierId  String?
  companyId   String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  supplier    Supplier?                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  company     Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  bankAccount BankAccount?             @relation("LetterOfCreditBankAccount", fields: [bankAccountId], references: [id])
  lcDocuments LetterOfCreditDocument[]

  // ── P2-Reconciliation: columns that exist in DB but were missing from schema ──
  lcNumber          String
  bankAccountId     String?
  companySlug       String
  // ── P2-Sprint6: schema reconciliation ──
  utilizationAmount Decimal @default(0)
  documentsRequired String?
  beneficiaryBank   String?

  @@unique([number, companyId])
  @@index([companyId])
  @@index([bankAccountId])
  @@index([companySlug])
  @@map("letters_of_credit")
}

model LetterOfCreditDocument {
  id               String         @id @default(cuid())
  letterOfCreditId String
  documentType     String
  fileName         String
  fileUrl          String?
  companySlug      String         @default("default")
  uploadedAt       DateTime       @default(now())
  letterOfCredit   LetterOfCredit @relation(fields: [letterOfCreditId], references: [id], onDelete: Cascade)

  @@index([companySlug])
  @@map("letter_of_credit_documents")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Extended Accounting Models
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Bank Account (matches db.bankAccount) ───

model BankAccount {
  id                  String               @id @default(cuid())
  name                String
  accountNumber       String
  bankName            String
  branch              String?
  iban                String?
  currency            String               @default("USD")
  balance             Decimal              @default(0)
  companyId           String
  companySlug         String               @default("default")
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  bankTransactions    BankTransaction[]
  bankReconciliations BankReconciliation[]
  // P0-06: back-relation for PaymentVoucher.bankAccountId
