  journalEntryIdFrom  Int?
  journalEntryIdTo    Int?
  status              String   @default("pending") // pending, posted, cancelled
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  @@index([companySlugFrom, status])
  @@index([companySlugTo, status])
}

// ── Landed Cost Allocation (allocate freight/customs to PO lines) ──
// Used by src/lib/accounting/trade-finance.ts and src/app/api/accounting/landed-cost/route.ts
model LandedCostAllocation {
  id                Int      @id @default(autoincrement())
  companySlug       String   @default("default")
  purchaseInvoiceId Int?
  costType          String   // freight, customs, insurance, etc.
  totalCost         Decimal  @default(0)
  allocationMethod  String   @default("quantity") // quantity, value, weight
  status            String   @default("draft") // draft, posted
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lines             LandedCostLine[]
  @@index([companySlug, purchaseInvoiceId])
}

// ── Landed Cost Line (per-line allocated cost) ──
// Created via nested write in trade-finance.ts (no direct callers found)
model LandedCostLine {
  id              Int      @id @default(autoincrement())
  allocationId    Int
  inventoryItemId Int?
  productId       Int?
  allocatedCost   Decimal  @default(0)
  baseQuantity    Decimal? @default(0)
  createdAt       DateTime @default(now())
  allocation      LandedCostAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  @@index([allocationId])
  @@index([productId])
}

// ── Installment Schedule (AR/AP payment plan) ──
// Used by src/lib/accounting/ar-ap.ts
model InstallmentSchedule {
  id              Int      @id @default(autoincrement())
  companySlug     String   @default("default")
  invoiceId       Int?
  totalAmount     Decimal  @default(0)
  paidAmount      Decimal  @default(0)
  status          String   @default("active") // active, completed, cancelled
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([companySlug, invoiceId])
}

