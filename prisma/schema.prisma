  reference          String?
  description        String?
  date               DateTime
  reconciled         Boolean             @default(false)
  reconciliationId   String?
  companyId          String
  companySlug        String              @default("default")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  bankAccount        BankAccount         @relation(fields: [bankAccountId], references: [id])
  bankReconciliation BankReconciliation? @relation(fields: [reconciliationId], references: [id])

  // ── P2-Reconciliation: columns that exist in DB but were missing from schema ──
  transactionType String
  isReconciled    Boolean
  reconciledWith  String?
  reconciledId    Int?
  category        String?

  // DB-13 FIX (Audit v2 · Phase 3): Optimistic locking for concurrent bank
  // transaction updates (reconciliation, import, manual edit). Bumped by the
  // application on every write and validated via WHERE version = <expected>.
  version Int @default(0)

  @@index([companySlug])
  @@index([companyId])
  // P1-3: FK index on bankAccountId — BankingView joins BankAccount -> transactions
  // and the reconciliation view filters by bankAccountId + reconciled.
  @@index([bankAccountId])
  // P1-3: date index — bank statement import + reconciliation queries
  // filter by date range
  @@index([date])
  // P5-M1: composite (companySlug, date) backs the reconciliation +
  // bank-import date-range list queries.
  @@index([companySlug, date])
  @@map("bank_transactions")
}

