// ═══════════════════════════════════════════════════════════════════════════════
// Multi-Tenant AI Configuration (P0: Per-Company, Per-Feature API Keys)
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Company AI Config (matches db.companyAIConfig) ───

// 🎯 ADVANCED MULTI-TENANT ARCHITECTURE
// 
// Each company gets ISOLATED API keys per FEATURE:
// ┌─────────────────────────────────────────────────────────────┐
// │  Company: "شركة النور للتجارة"                              │
// ├─────────────────────────────────────────────────────────────┤
// │  🔑 chatApiKey      → For AI Chat conversations             │
// │  📄 invoiceApiKey   → For invoice extraction & processing    │
// │  🔍 parseApiKey     → For smart document parsing            │
// │  🧠 memoryApiKey    → For context memory & history          │
// └─────────────────────────────────────────────────────────────┘
//
// Benefits:
// ✅ No bottleneck - each feature has its own rate limit
// ✅ If chat is busy, invoices still process
// ✅ Per-feature quota management
// ✅ Independent enable/disable per feature
// ✅ Different models per feature if needed

model CompanyAIConfig {
  id        String @id @default(cuid())
  companyId String @unique

  // ═══════════════════════════════════════════════════════════
  // PER-FEATURE API KEYS (Isolated Connections)
  // Each feature gets its own API key → no shared bottleneck!
  // ═══════════════════════════════════════════════════════════

  // 💬 Chat Feature - AI Conversations & Copilot
  // Used for: Chat messages, Q&A, suggestions
  chatApiKey        String  @default("") // Encrypted key
  chatModel         String  @default("gemini-2.0-flash")
  chatEnabled       Boolean @default(false) // Founder must enable
  chatRateLimitRpm  Int     @default(60)
  chatTokensUsed    BigInt  @default(0)
  chatRequestsCount BigInt  @default(0)

  // 📄 Invoice Feature - Extraction & Processing
  // Used for: Invoice OCR, data extraction, line items
  invoiceApiKey        String  @default("") // Encrypted key
  invoiceModel         String  @default("gemini-2.0-flash")
  invoiceEnabled       Boolean @default(false)
  invoiceRateLimitRpm  Int     @default(100) // Higher limit for batch processing
  invoiceTokensUsed    BigInt  @default(0)
  invoiceRequestsCount BigInt  @default(0)

  // 🔍 Smart Parse - Document Analysis
  // Used for: Document parsing, categorization, matching
  parseApiKey        String  @default("") // Encrypted key
  parseModel         String  @default("gemini-2.0-flash")
  parseEnabled       Boolean @default(false)
  parseRateLimitRpm  Int     @default(80)
  parseTokensUsed    BigInt  @default(0)
  parseRequestsCount BigInt  @default(0)

  // 🧠 Memory & Context - Conversation History
  // Used for: Context storage, user preferences, learning
  memoryApiKey        String  @default("") // Encrypted key
  memoryModel         String  @default("gemini-2.0-flash")
  memoryEnabled       Boolean @default(false)
  memoryRateLimitRpm  Int     @default(30) // Lower - less frequent
  memoryTokensUsed    BigInt  @default(0)
  memoryRequestsCount BigInt  @default(0)

  // ═══════════════════════════════════════════════════════════
  // SHARED CONFIGURATION
  // ═══════════════════════════════════════════════════════════

  // Default provider info (for backward compatibility)
  primaryProvider  String  @default("{}")
  fallbackProvider String?

  // Company-specific system prompt for AI context
  systemPrompt String @default("")

  // Memory configuration
  memoryRetentionDays Int @default(30)

  // Cost optimization: aggressive | balanced | quality
  costOptimization String @default("balanced")

  // Usage notifications
  notifyHighUsage            Boolean @default(true)
  usageNotificationThreshold Int     @default(80) // %

  // Global usage tracking (reset monthly)
  tokensUsedThisMonth BigInt   @default(0)
  requestsThisMonth   BigInt   @default(0)
  lastResetAt         DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_ai_configs")
}

// ═══════════════════════════════════════════════════════════════════
// API Key Pool System
// 
// Founder uploads API keys → Auto-distribute to new users
// Track usage, remaining, alerts when low
// ═══════════════════════════════════════════════════════════════════

model ApiKeyPool {
  id String @id @default(cuid())

  // The actual API key (encrypted at rest)
  keyValue String @unique

  // Provider detection (auto-detected from key format)
  provider String @default("openrouter") // openrouter | gemini | openai

  // Which model(s) this key is for
  model String @default("deepseek/deepseek-chat-v3-0324")

  // Status tracking
  status String @default("available") // available | assigned | exhausted | revoked

  // Who's using this key (if assigned)
  assignedToUserId    String?   @unique // One key per user
  assignedToCompanyId String? // User's company
  assignedAt          DateTime?

  // Usage tracking
  timesUsed  BigInt    @default(0)
  lastUsedAt DateTime?

  // Rate limit info for this specific key
  rpmLimit   Int       @default(60) // Requests per minute
  dailyLimit Int       @default(1000) // Requests per day
  usedToday  BigInt    @default(0)
  resetAt    DateTime? // When daily counter resets

  // Metadata
  addedBy  String? // Founder user ID
  notes    String? // Internal notes
  priority Int     @default(0) // Higher = use first

  // Alerts
  lowUsageAlert  Boolean @default(true) // Alert when running low
  alertThreshold Int     @default(10) // Alert when X% used

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assignedUser    AppUser? @relation("KeyAssignedToUser", fields: [assignedToUserId], references: [uid])
  assignedCompany Company? @relation("KeyAssignedToCompany", fields: [assignedToCompanyId], references: [id])

  @@index([status])
  @@index([provider])
  @@index([assignedToUserId])
  @@map("api_key_pool")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Accounting Module - Recurring & Fiscal Year Features
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Recurring Journal Entry (قيد دوري) ───
// Automated recurring journal entries that generate JEs on a schedule.

model RecurringJournalEntry {
  id          String @id @default(cuid())
  companyId   String
  companySlug String @default("default")

  title       String
  description String?

  // Schedule
  frequency     String // 'daily', 'weekly', 'monthly', 'quarterly', 'yearly'
  intervalValue Int       @default(1) // e.g., every 2 months
  startDate     DateTime
  endDate       DateTime? // null = forever
  nextRunDate   DateTime
  lastRunDate   DateTime?

  // Entry template (copied on each run)
  templateLines Json // Array of {accountId, debit, credit, description}

  // Auto-post settings
  autoPost        Boolean @default(true)
  requireApproval Boolean @default(false)

  // Status
  isActive    Boolean @default(true)
  totalPosted Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([companySlug])
  @@index([companyId, isActive])
  @@index([nextRunDate])
  @@map("recurring_journal_entries")
}

// ─── Fiscal Year Close (إغلاق السنة المالية) ───
// Records when a fiscal year is closed and its state.

model FiscalYearClose {
  id                      String   @id @default(cuid())
  companyId               String
  companySlug             String   @default("default")
  year                    Int
  closedAt                DateTime
  closedBy                String // userId (email or uid)
  openingRetainedEarnings Decimal  @default(0) // Calculated P&L carried forward
  notes                   String?

  // Snapshots
  trialBalanceSnapshot Json? // TB at time of close

  isReopened Boolean   @default(false)
  reopenedAt DateTime?
  reopenedBy String?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, year])
  @@index([companySlug])
  @@index([year])
  @@map("fiscal_year_closes")
}

// ─── Outbox Event ───

model PromptTemplate {
  id        String   @id @default(cuid())
  name      String
  version   Int      @default(1)
  content   String   @db.Text
  changeLog String?
  active    Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, version])
  @@index([name, active])
  @@index([active])
  @@map("prompt_templates")
}

// Phase 4 P3: CompanyMembership join table (replaces AppUser.companies JSON string).
// Currently AppUser.companies is a JSON-encoded string column — every membership
// query is a substring/contains filter, and mutations rewrite the whole array.
// This model is the proper relational approach. Migration TBD (needs data backfill
// from the JSON column). The JSON column stays for backward compatibility until
// all code is migrated to use CompanyMembership.
model CompanyMembership {
  id          String   @id @default(cuid())
  userUid     String
  companySlug String
  role        String   @default("employee") // admin, employee, accountant
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    AppUser @relation(fields: [userUid], references: [uid], onDelete: Cascade)
  company Company @relation(fields: [companySlug], references: [slug], onDelete: Restrict)

  @@unique([userUid, companySlug])
  @@index([companySlug])
  @@index([userUid])
  @@map("company_memberships")
}

// #27 P1 FIX: StorageObject — maps storage keys to companySlug for tenant isolation.
// Previously /api/storage/[key] had no tenant scoping — any authenticated user
// could fetch any file by knowing the UUID. This model enables assertCompanyAccess
// on file access. The migration creates the table; backfill is done by scanning
// existing files and inferring companySlug from the upload context (manual step).
model StorageObject {
  id          String   @id @default(cuid())
  key         String   @unique // the UUID-style filename (e.g., "a1b2c3d4.png")
  companySlug String
  uploadedBy  String? // userUid of the uploader
  fileSize    Int      @default(0)
  mimeType    String   @default("application/octet-stream")
  createdAt   DateTime @default(now())

  @@index([companySlug])
  @@map("storage_objects")
}
