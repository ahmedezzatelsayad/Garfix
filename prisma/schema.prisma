// ─── Payment Transaction (matches db.paymentTransaction) ───

// P2-Sprint-4: aligned with code usage in subscription-engine.ts + payment routes.
// Previous schema was missing: plan, provider, currency, providerPaymentId,
// providerOrderId, providerEventId, checkoutUrl, failureReason, metadata, createdBy.
// These are all used by the MyFatoorah/Paymob payment flow but were never declared,
// meaning every PaymentTransaction.create with these fields would throw at runtime.
model PaymentTransaction {
  id                String    @id @default(cuid())
  invoiceId         Int?
  amount            Decimal
  method            String // cash, bank_transfer, card, online
  reference         String?
  date              DateTime  @default(now())
  status            String    @default("completed") // completed, pending, failed, reversed
  companySlug       String    @default("default")
  companyId         String?
  // P2-Sprint-4: subscription billing + provider tracking fields
  plan              String?
  provider          String?
  currency          String    @default("USD")
  providerPaymentId String?
  providerOrderId   String?
  providerEventId   String?
  checkoutUrl       String?
  failureReason     String?
  metadata          String? // JSON-encoded
  createdBy         String?
  deletedAt         DateTime? // P0-3: Soft Delete
  deletedBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  invoice           Invoice?  @relation(fields: [invoiceId], references: [id])
  version           Int       @default(0) // Phase 15 P0: Optimistic Locking

  @@index([companySlug])
  @@index([companyId])
  @@index([provider, providerPaymentId])
  @@index([status])
  // P5-M1: composite (companySlug, createdAt) backs the tenant+time-range
  // list ordering used by GET /api/payments.
  @@index([companySlug, createdAt])
  @@index([invoiceId])
  @@map("payment_transactions")
}

// ─── Refund Transaction (matches db.refundTransaction) ───

// P2-Sprint-4: aligned with code usage in myfatoorah-refund.ts.
// Previous schema was missing: paymentTransactionId, providerRefundId,
