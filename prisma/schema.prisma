// NOTE: Financial fields use Decimal instead of Float for production accuracy.
// SQLite doesn't support Decimal, so in dev it falls back to Float-like behavior.
// For PostgreSQL production, Decimal ensures exact precision (no floating-point errors).
// This prevents issues like 0.1 + 0.2 = 0.30000000000000004

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"  // Change to "postgresql" for production
  url      = env("DATABASE_URL")
}

// ─── Core Business Models ────────────────────────────────────────────────

model Company {
  id                        Int      @id @default(autoincrement())
  name                      String
  slug                      String   @unique
  logoBase64                String?
  nameAr                    String?
  emoji                     String?
  color                     String?
  phone                     String?
  email                     String?
  address                   String?
  vatNumber                 String?
  commercialRegistration    String?
  currency                  String   @default("KWD")
  country                   String?
  timezone                  String?
  defaultTaxRate            String   @default("0")
  weekendDays               String   @default("[5,6]")
  ramadanHours              Boolean  @default(false)
  openrouterApiKey          String?
  openrouterModel           String   @default("anthropic/claude-3.5-haiku")
  plan                      String   @default("trial")
  subscriptionStatus        String   @default("active")
  trialEndsAt               DateTime?
  stripeCustomerId          String?
  stripeSubscriptionId      String?
  whatsappEnabled           Boolean  @default(false)
  whatsappBusinessNumber    String?
  whatsappPhoneNumberId     String?
  whatsappAccessTokenEnc    String?
  whatsappAppSecretEnc      String?
  whatsappVerifyTokenHash   String?
  whatsappGreeting          String?
  whatsappCredentialsUpdatedAt DateTime?
  deletedAt                 DateTime?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  // Relations
  companyRuntime            CompanyRuntime?
  clients                   Client[]
  productCatalogs           ProductCatalog[]
  warehouses                Warehouse[]
  invoices                  Invoice[]

  inventoryItems            InventoryItem[]

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([subscriptionStatus])
  @@index([plan])
  @@index([deletedAt])
  @@map("companies")
}

model Client {
  id          Int      @id @default(autoincrement())
  name        String
  email       String?
  phone       String?
  company     String?
  address     String?
  notes       String?
  companySlug String
  deletedAt   DateTime?
  deletedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  companyRef  Company  @relation(fields: [companySlug], references: [slug])

  @@index([companySlug])
  @@index([companySlug, deletedAt])
  @@map("clients")
}

model ProductCatalog {
  id              Int      @id @default(autoincrement())
  code            String?
  name            String
  aliases         String   @default("[]")
  purchasePrice   String?
  sellingPrice    String?
  wholesalePrice  String?
  companySlug     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  companyRef      Company  @relation(fields: [companySlug], references: [slug])
  inventoryItems  InventoryItem[]

  @@index([companySlug])
  @@map("product_catalog")
}

model Warehouse {
  id              Int      @id @default(autoincrement())
  companySlug     String
  name            String
  code            String
  address         String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  companyRef      Company  @relation(fields: [companySlug], references: [slug])
  inventoryItems  InventoryItem[]

  @@unique([companySlug, code])
  @@index([companySlug])
  @@index([companySlug, isActive])
  @@map("warehouses")
}

model InventoryItem {
  id           Int      @id @default(autoincrement())
  companySlug  String
  warehouseId  Int
  productId    Int
  quantity     String   @default("0")
  reorderLevel String   @default("0")
  reorderQty   String   @default("0")
  batchNumber  String?
  expiryDate   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  warehouse    Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product      ProductCatalog @relation(fields: [productId], references: [id], onDelete: Cascade)
  companyRef   Company  @relation(fields: [companySlug], references: [slug])

  @@unique([warehouseId, productId])
  @@index([companySlug])
  @@index([productId])
  @@index([warehouseId])
  @@map("inventory_items")
}

model Invoice {
  id                Int      @id @default(autoincrement())
  invoiceNumber     String
  companySlug       String
  clientId          Int?
  clientName        String
  clientEmail       String?
  clientPhone       String?
  clientAddress     String?
  issueDate         String
  dueDate           String
  status            String   @default("draft")
  lineItems         String   @default("[]")
  subtotal          String   @default("0")
  taxRate           String   @default("0")
  taxAmount         String   @default("0")
  total             String   @default("0")
  shipping          String   @default("0")
  discount          String   @default("0")
  paid              String   @default("0")
  notes             String?
  source            String?
  createdByEmail    String?
  createdByName     String?
  whatsappRawText   String?
  parsedConfidence  String?
  journalEntryId    Int?
  eInvoiceStatus    String?
  deliveryMethod    String?
  version           Int      @default(0)
  deletedAt         DateTime?
  deletedBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  companyRef        Company  @relation(fields: [companySlug], references: [slug])

  @@unique([companySlug, invoiceNumber])
  @@index([companySlug])
  @@index([companySlug, issueDate])
  @@index([companySlug, status])
  @@index([clientId])
  @@index([companySlug, deletedAt])
  @@index([companySlug, eInvoiceStatus])
  @@index([companySlug, dueDate, status])
  @@index([invoiceNumber])
  @@index([status])
  @@map("invoices")
}

// ─── AI Fabric Models ────────────────────────────────────────────────────

model CompanyRuntime {
  id                     Int      @id @default(autoincrement())
  companyId              Int      @unique
  workerPoolSize         Int      @default(2)
  status                 String   @default("active")
  slaTier                String   @default("starter")
  maxAcceptableLatencyMs Int      @default(2000)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([slaTier])
  @@map("company_runtimes")
}

model AIRequestLog {
  id          Int      @id @default(autoincrement())
  companySlug String
  requestType String
  resolvedBy  String
  provider    String?
  tokensUsed  Int?
  costUsd     Float    @default(0)
  latencyMs   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([companySlug, createdAt])
  @@index([companySlug, resolvedBy, createdAt])
  @@index([requestType, resolvedBy, createdAt])
  @@index([resolvedBy, createdAt])
  @@map("ai_request_logs")
}

model CacheEntry {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  companySlug String
  value       String
  hitCount    Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companySlug])
  @@index([expiresAt])
  @@map("ai_fabric_cache_entries")
}

model BudgetConfig {
  id               Int      @id @default(autoincrement())
  companySlug      String   @unique
  monthlyBudgetUsd Float
  currentSpendUsd  Float    @default(0)
  alertThresholdPct Int     @default(80)
  hardStopEnabled  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([companySlug])
  @@map("budget_configs")
}

model ProviderConfig {
  id                Int      @id @default(autoincrement())
  taskType          String   @unique
  primaryProvider   String
  fallbackProvider  String
  costPerRequestUsd Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("provider_configs")
}

model AIMemoryEntry {
  id             Int      @id @default(autoincrement())
  companySlug    String
  category       String
  content        String
  createdAt      DateTime @default(now())
  lastAccessedAt DateTime @default(now())

  @@index([companySlug, category])
  @@index([companySlug, category, lastAccessedAt])
  @@index([lastAccessedAt])
  @@map("ai_memory_entries")
}

model ProfitSnapshot {
  id           Int      @id @default(autoincrement())
  companySlug  String
  periodStart  DateTime
  periodEnd    DateTime
  revenueUsd   Float    @default(0)
  infraCostUsd Float    @default(0)
  aiCostUsd    Float    @default(0)
  workerCostUsd Float   @default(0)
  profitUsd    Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([companySlug, periodStart])
  @@index([periodStart, periodEnd])
  @@map("profit_snapshots")
}

model RuleCandidate {
  id                Int      @id @default(autoincrement())
  companySlug       String
  requestType       String
  patternSignature  String
  sampleCount       Int      @default(0)
  consistentOutput  String
  confidence        Float    @default(0)
  status            String   @default("observing")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companySlug, status])
  @@index([companySlug, patternSignature])
  @@index([status, confidence])
  @@map("rule_candidates")
}

model GlobalPattern {
  id                        Int      @id @default(autoincrement())
  patternKey                String   @unique
  suggestedSku              String?
  suggestedVatCategory      String?
  suggestedCategory         String?
  contributingCompaniesCount Int     @default(0)
  confidence                Float    @default(0)
  lastUpdated               DateTime

  @@index([confidence])
  @@index([lastUpdated])
  @@map("global_patterns")
}

model AIScoreSnapshot {
  id               Int      @id @default(autoincrement())
  companySlug      String
  period           String
  score            Float    @default(0)
  cacheHitPct      Float    @default(0)
  ruleHitPct       Float    @default(0)
  aiCallPct        Float    @default(0)
  avgCostPerRequest Float   @default(0)
  createdAt        DateTime @default(now())

  @@unique([companySlug, period])
  @@index([companySlug, createdAt])
  @@index([score])
  @@map("ai_score_snapshots")
}

model CompiledRule {
  id                          Int      @id @default(autoincrement())
  requestType                 String
  patternDescription          String
  logicType                   String
  logicDefinition             String
  accuracyOnHistoricalSample  Float    @default(0)
  status                      String   @default("pending_review")
  reviewedBy                  String?
  reviewedAt                  DateTime?
  sourceCandidateId           Int?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([status])
  @@index([requestType, status])
  @@index([accuracyOnHistoricalSample])
  @@map("compiled_rules")
}

model JobQueue {
  id           Int       @id @default(autoincrement())
  queue        String
  type         String
  data         String
  status       String    @default("pending")
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  lastError    String?
  lockedAt     DateTime?
  lockedBy     String?
  scheduledAt  DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([queue, status, scheduledAt])
  @@index([status, scheduledAt])
  @@map("job_queue")
}

model Notification {
  id          Int      @id @default(autoincrement())
  userUid     String
  companySlug String?
  type        String
  title       String
  body        String
  link        String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  readAt      DateTime?

  @@index([userUid, isRead])
  @@index([userUid, createdAt])
  @@index([companySlug])
  @@map("notifications")
}

// ─── Legacy Models (kept for compatibility) ──────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  role      String   @default("user")
  companyId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Accounting Models (from original schema, kept for compatibility) ─────

model Account {
  id                String   @id @default(cuid())
  code              String
  name              String
  type              String
  parentId          String?
  companyId         String
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  parent            Account?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children          Account[] @relation("AccountHierarchy")
  voucherLines      VoucherLine[]
  openingBalances   OpeningBalance[]
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  code        String
  email       String?
  phone       String?
  address     String?
  taxId       String?
  companyId   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FinancialPeriod {
  id          String   @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  status      String   @default("open")
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Voucher {
  id            String   @id @default(cuid())
  number        String
  date          DateTime
  description   String?
  reference     String?
  status        String   @default("draft")
  voucherType   String   @default("general")
  companyId     String
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lines         VoucherLine[]
}

model VoucherLine {
  id           String   @id @default(cuid())
  accountId    String
  debit        Decimal  @default(0)
  credit       Decimal  @default(0)
  description  String?
  sortOrder    Int      @default(0)
  voucherId    String
  account      Account  @relation(fields: [accountId], references: [id])
  voucher      Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
}

model PaymentVoucher {
  id            String   @id @default(cuid())
  number        String
  date          DateTime
  amount        Decimal
  paymentType   String
  direction     String
  status        String   @default("draft")
  description   String?
  reference     String?
  clientId      String?
  supplierId    String?
  companyId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  installments  Installment[]
}

model Installment {
  id              String   @id @default(cuid())
  paymentVoucherId String
  amount          Decimal
  dueDate         DateTime
  status          String   @default("pending")
  paidDate        DateTime?
  paymentRef      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  paymentVoucher  PaymentVoucher @relation(fields: [paymentVoucherId], references: [id], onDelete: Cascade)
}

model OpeningBalance {
  id          String   @id @default(cuid())
  accountId   String
  periodId    String
  debit       Decimal  @default(0)
  credit      Decimal  @default(0)
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  account     Account  @relation(fields: [accountId], references: [id])
  @@unique([accountId, periodId])
}

model ProfitDistribution {
  id              String   @id @default(cuid())
  periodId        String?
  totalProfit     Decimal  @default(0)
  retained        Decimal  @default(0)
  distributed     Decimal  @default(0)
  distributionType String  @default("proportional")
  status          String   @default("draft")
  notes           String?
  companyId       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  entries         ProfitDistributionEntry[]
}

model ProfitDistributionEntry {
  id             String   @id @default(cuid())
  distributionId String
  shareholder    String
  shareRatio     Decimal  @default(0)
  amount         Decimal  @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  distribution   ProfitDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
}

model LetterOfCredit {
  id            String   @id @default(cuid())
  number        String
  type          String   @default("import")
  amount        Decimal
  currency      String   @default("USD")
  status        String   @default("draft")
  issueDate     DateTime?
  expiryDate    DateTime?
  beneficiary   String?
  issuingBank   String?
  description   String?
  reference     String?
  supplierId    String?
  companyId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lcDocuments   LetterOfCreditDocument[]
}

model LetterOfCreditDocument {
  id              String   @id @default(cuid())
  letterOfCreditId String
  documentType    String
  fileName        String
  fileUrl         String?
  uploadedAt      DateTime @default(now())
  letterOfCredit  LetterOfCredit @relation(fields: [letterOfCreditId], references: [id], onDelete: Cascade)
}
