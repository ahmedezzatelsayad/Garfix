// ─── E-Invoice Clearance Receipt (inbound webhook payloads from tax authorities) ───
// Each row = one inbound webhook call from a tax authority portal telling us
// about a clearance / rejection / status change for an e-invoice.

model EInvoiceReceipt {
  id              String   @id @default(cuid())
  companySlug     String
  invoiceId       Int? // nullable: some webhooks arrive before invoice row exists
  authority       String // zatca, eta_egypt, uae_fta, kuwait_decree_10_2026, bahrain_nbr, oman_tax, qatar_gta
  eventType       String // clearance_requested, cleared, rejected, cancelled, delivery_report
  externalUuid    String? // UUID issued by the authority (e.g. ZATCA invoice UUID, ETA document UUID)
  status          String // accepted, rejected, pending, cancelled
  rawPayload      String // full JSON body as received (for audit / debugging)
  signatureValid  Boolean? // whether HMAC/X-Hub-Signature verified (null if no signature header)
  rejectionReason String?
  receivedAt      DateTime @default(now())

  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@unique([externalUuid, authority, eventType])
  @@index([companySlug])
  @@index([companySlug, authority])
  @@index([companySlug, receivedAt])
  @@index([externalUuid])
  @@map("e_invoice_receipts")
}

// ─── ZATCA Certificate (matches db.zatcaCertificate) ───

model ZatcaCertificate {
  id                 String    @id @default(cuid())
  companySlug        String
  certificateType    String // csid, ccd
  certificateDataEnc String? // AES-256-GCM encrypted X.509 PEM
  privateKeyDataEnc  String? // AES-256-GCM encrypted private key
  serialNumber       String?
  expiryDate         DateTime?
  status             String    @default("active") // active, expired, revoked, pending
  createdAt          DateTime  @default(now())
