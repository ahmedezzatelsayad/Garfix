// ═══════════════════════════════════════════════════════════════════════════════

// ─── Audit Log (matches db.auditLog) ───

model AuditLog {
  id          Int      @id @default(autoincrement())
  userUid     String?
  userEmail   String?
  action      String
  entity      String?
  entityId    String?
  companySlug String?
  details     String? // JSON
  createdAt   DateTime @default(now())

  @@index([companySlug])
  // P1-3: append-only audit log grows unboundedly. Without an index on
  // createdAt, `ORDER BY createdAt DESC LIMIT 50` is a full scan.
  @@index([createdAt])
  // P1-3: entity+entityId index — the audit trail UI filters by entity
  // ("show me all changes to Invoice #123") — without this it's a scan.
  @@index([entity, entityId])
  // P1-3: userUid index — "show me all actions by user X" queries
  @@index([userUid])
  @@map("audit_logs")
}

// ─── Accounting Audit Log (matches db.accountingAuditLog) ───

model AccountingAuditLog {
  id          Int      @id @default(autoincrement())
  companySlug String
