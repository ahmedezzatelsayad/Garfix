// ═══════════════════════════════════════════════════════════════════════════════
// Invoice & Sales Models
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Invoice (matches db.invoice) ───

model Invoice {
  id                    Int                  @id @default(autoincrement())
  invoiceNumber         String
  clientName            String?
  clientId              String?
  issueDate             DateTime             @default(now())
  dueDate               DateTime?
  total                 Decimal              @default(0)
  subtotal              Decimal              @default(0)
  taxAmount             Decimal              @default(0)
  status                String               @default("draft") // draft, sent, paid, cancelled
  source                String?
  eInvoiceAuthority     String? // zatca, uae_fta, kuwait_decree_10_2026, etc.
  companySlug           String               @default("default")
  companyId             String?
  version               Int                  @default(0) // P0-8: Optimistic Locking
  deletedAt             DateTime? // P0-3: Soft Delete
  // Fields written by POST /api/invoices (were missing → 500 on every create).
  lineItems             String               @default("[]") // JSON-encoded array of line items
  clientEmail           String?
  clientPhone           String?
  clientAddress         String?
  taxRate               Decimal              @default(0)
  shipping              Decimal              @default(0)
  paid                  Decimal              @default(0)
  discount              Decimal              @default(0)
  notes                 String?
  createdByEmail        String?
  createdByName         String?
  deletedBy             String?
  // Kuwait-compliance fields (DECREE 10/2026)
  hijriIssueDate        String?
  hijriDueDate          String?
  mociNumber            String?
  invoiceTypeAr         String?
  invoiceTypeEn         String?
  sellerNameAr          String?
  sellerAddressAr       String?
  buyerNameAr           String?
  buyerAddressAr        String?
  lineItemsAr           String?
  notesAr               String?
  currencyDecimalPlaces Int?
  // ── Branch/Warehouse support: invoice issued from a specific branch ──
  warehouseId           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  company               Company?             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client                Client?              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  eInvoice              EInvoice?
  eInvoiceReceipts      EInvoiceReceipt[]
  paymentTransactions   PaymentTransaction[]
  warehouse             Warehouse?           @relation(fields: [warehouseId], references: [id])

  @@unique([companySlug, invoiceNumber])
  @@index([companyId])
  // P1-3: invoices/route.ts list query filters `where: { companySlug, deletedAt: null, status }`
  // and orders by createdAt DESC. Add composite + date indexes.
  @@index([companySlug, deletedAt])
  @@index([status, createdAt])
  @@index([warehouseId])
  // P5-M1: composite (companySlug, createdAt) backs the tenant+time-range list
  // ordering used by GET /api/invoices. Without it Postgres picked the
  // single-column companySlug index and sorted in memory.
  @@index([companySlug, createdAt])
  @@index([clientId])
  @@map("invoices")
}

// ─── Purchase Invoice (matches db.purchaseInvoice) ───

model PurchaseInvoice {
  id               String    @id @default(cuid())
  invoiceNumber    String
  supplierId       String?
  issueDate        DateTime  @default(now())
  dueDate          DateTime?
  total            Decimal   @default(0)
  status           String    @default("draft") // draft, received, paid, cancelled
  companySlug      String    @default("default")
  companyId        String?
  deletedAt        DateTime? // P0-3: Soft Delete
  // Fields written by POST /api/purchases — the API code uses these names
  // (was missing → 500 on every purchase create). Kept alongside the
  // canonical invoiceNumber/issueDate/total so both old and new code paths work.
  num              String?
  date             DateTime?
  supplier         String?
  items            String? // JSON-encoded array
  sourceInvoiceIds String? // JSON-encoded array
  totalQty         Decimal   @default(0)
  totalAmount      Decimal   @default(0)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  supplierRel      Supplier? @relation(fields: [supplierId], references: [id])
  company          Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  version          Int       @default(0) // Phase 15 P0: Optimistic Locking

  // ── P2-Reconciliation: columns that exist in DB but were missing from schema ──
  supplierName          String?
  lineItems             String
  subtotal              Decimal                @default(0) // DB-07 FIX: String→Decimal
  taxRate               Decimal                @default(0) // DB-07 FIX: String→Decimal
  taxAmount             Decimal                @default(0) // DB-07 FIX: String→Decimal
  paid                  Decimal                @default(0) // DB-07 FIX: String→Decimal
  purchaseOrderId       Int?
  createdBy             String?
  // P2-Sprint6: back-relation for LandedCostAllocation
  landedCostAllocations LandedCostAllocation[]

  @@index([companySlug])
  @@index([companyId])
  // P1-3: soft-delete + supplier FK indexes
  @@index([companySlug, deletedAt])
  @@index([supplierId])
  @@map("purchase_invoices")
}

// ─── Quotation (matches db.quotation) ───

model Quotation {
  id          String    @id @default(cuid())
  number      String
  clientId    String?
  issueDate   DateTime  @default(now())
  expiryDate  DateTime?
  total       Decimal   @default(0)
  status      String    @default("draft") // draft, sent, accepted, rejected, converted
  companySlug String    @default("default")
  companyId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
