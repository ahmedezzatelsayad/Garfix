  companySlug           String               @default("default")
  companyId             String?
  version               Int                  @default(0) // P0-8: Optimistic Locking
  deletedAt             DateTime? // P0-3: Soft Delete
  // Fields written by POST /api/invoices (were missing → 500 on every create).
  lineItems             String               @default("[]") // JSON-encoded array of line items
  clientEmail           String?
  clientPhone           String?
  clientAddress         String?
  taxRate               Decimal              @default(0)
  shipping              Decimal              @default(0)
  paid                  Decimal              @default(0)
  discount              Decimal              @default(0)
  notes                 String?
  createdByEmail        String?
