# ─────────────────────────────────────────────────────────────────────────────
# Local development environment
# PostgreSQL is the ONLY supported database. SQLite is NOT compatible with
# this codebase (Decimal types, cuid() string IDs, RLS policies, JSON columns).
# ─────────────────────────────────────────────────────────────────────────────
#
# To set up local PostgreSQL:
#   1. Install PostgreSQL 17+
#   2. Create database + user:
#        sudo -u postgres psql -c "CREATE USER garfix WITH PASSWORD 'garfix_dev';"
#        sudo -u postgres psql -c "CREATE DATABASE garfix OWNER garfix;"
#   3. Update DATABASE_URL below with real credentials
#   4. Run: bun run db:deploy   (applies all migrations)
#   5. Run: bun run seed        (loads demo data)
#
# For production / staging, set these via your hosting provider's secret
# manager (Vercel/Neon/RDS Secrets Manager) — never commit real secrets.

DATABASE_URL="postgresql://garfix:garfix_dev@localhost:5432/garfix?schema=public&connection_limit=20&pool_timeout=30"
DATABASE_DIRECT_URL="postgresql://garfix:garfix_dev@localhost:5432/garfix"

# Override with real Neon URL when available:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXXX.us-east-2.aws.neon.tech/garfix?schema=public&sslmode=require"
# DATABASE_DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXXX.us-east-2.aws.neon.tech/garfix?sslmode=require"
