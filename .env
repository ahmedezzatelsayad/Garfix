# ──────────────────────────────────────────────────────────────────────────────
# Valkey (Redis-compatible) — Primary Queue & Cache Backend
# ──────────────────────────────────────────────────────────────────────────────
# Valkey is the PRIMARY queue/cache backend for production.
# When configured, BullMQ uses Valkey for job processing.
# If Valkey is unavailable, the system falls back to pg-boss (PostgreSQL).
#
# For local development with Docker:
#   docker run -d --name garfix-valkey -p 6379:6379 valkey/valkey:8.1 --requirepass garfix_dev_2024
#
# Or use docker-compose:
#   docker-compose up -d valkey
# ──────────────────────────────────────────────────────────────────────────────
VALKEY_URL=valkey://:garfix_dev_2024@localhost:6379
VALKEY_PASSWORD=garfix_dev_2024

