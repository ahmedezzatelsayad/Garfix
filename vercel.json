{
  "buildCommand": "bunx prisma generate && next build --webpack",
  "installCommand": "bun install",
  "framework": "nextjs",
  "regions": ["iad1"],
  "functions": {
    "src/app/api/**/route.ts": {
      "maxDuration": 60
    }
  },
  "includeFiles": "node_modules/.prisma/client/**",
  "crons": [
    {
      "path": "/api/internal/cron/session-sweep",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/internal/cron/outbox-purge",
      "schedule": "30 * * * *"
    }
  ]
}
